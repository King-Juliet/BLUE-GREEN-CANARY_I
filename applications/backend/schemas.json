{
  "products": {
    "compatibility": "BACKWARD",
    "versions": {
      "1": {
        "description": "Canonical product contract for frontend listing and ordering.",
        "schema": {
          "type": "object",
          "required": ["id", "name", "category", "price"],
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "category": { "type": "string" },
            "price": { "type": "number" }
          }
        }
      }
    }
  },
  "orders": {
    "compatibility": "BACKWARD",
    "versions": {
      "1": {
        "description": "Canonical order contract for database and API exchange.",
        "schema": {
          "type": "object",
          "required": ["id", "customer_name", "customer_email", "city", "product_id", "product_name", "price", "status", "schema_version"],
          "properties": {
            "id": { "type": "integer" },
            "customer_name": { "type": "string" },
            "customer_email": { "type": "string" },
            "city": { "type": "string" },
            "product_id": { "type": "integer" },
            "product_name": { "type": "string" },
            "price": { "type": "number" },
            "status": { "type": "string" },
            "schema_version": { "type": "string" }
          }
        }
      },
      "2": {
        "description": "Adds optional discount_code. A region whose database is still on the v1 shape falls back to writing v1 rows instead of failing.",
        "schema": {
          "type": "object",
          "required": ["id", "customer_name", "customer_email", "city", "product_id", "product_name", "price", "status", "schema_version"],
          "properties": {
            "id": { "type": "integer" },
            "customer_name": { "type": "string" },
            "customer_email": { "type": "string" },
            "city": { "type": "string" },
            "product_id": { "type": "integer" },
            "product_name": { "type": "string" },
            "price": { "type": "number" },
            "status": { "type": "string" },
            "schema_version": { "type": "string" },
            "discount_code": { "type": "string" }
          }
        }
      }
    }
  }
}